{
  "manifest_version": 3,
  "name": "Hearth Speed Dial",
  "version": "0.1.0",
  "description": "New tab speed dial for one folder of your bookmarks.",
  "permissions": ["bookmarks", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
