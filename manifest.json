{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_ext_name__",
  "version": "0.3.0",
  "description": "__MSG_ext_description__",
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "favicon",
    "contextMenus",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_page": "settings.html"
}
