{
  "name": "hearth-speed-dial",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "node scripts/prepare-firefox-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test --test-reporter=spec src/**/*.test.ts scripts/**/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-reporter=spec src/**/*.test.ts",
    "icons": "node scripts/draw-icons.mjs",
    "pack:chrome": "node scripts/pack-chrome.mjs",
    "pack:firefox": "node scripts/pack-firefox.mjs",
    "browser:chrome": "node scripts/launch-chrome.mjs",
    "browser:firefox": "node scripts/launch-firefox.mjs",
    "browser:reset": "node scripts/reset-browser-profiles.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
